---
import MainLayout from '../../layouts/MainLayout.astro';
const title = '醫院照護到臨時支援：高雄醫院居家看護與高雄臨時看護的完整規劃';
const description = '從醫院照護到臨時居家支援如何無縫銜接？本文深入介紹高雄醫院居家看護的服務內容、高雄臨時看護的彈性應用，以及如何為家人規劃完整的照護轉換方案。';
const date = '2026-06-15';
const keywords = ['高雄醫院居家看護', '高雄臨時看護'];
---

<MainLayout title={title} description={description} type="article">
  <script type="application/ld+json" slot="head">
    {JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": title,
      "description": description,
      "author": {"@type": "Organization", "name": "宇涵居家照護站"},
      "publisher": {
        "@type": "Organization",
        "name": "宇涵居家照護站",
