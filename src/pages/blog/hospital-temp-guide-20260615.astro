      "dateModified": date,
      "mainEntityOfPage": {"@type": "WebPage", "@id": "https://yuhanhomecare.com/blog/hospital-temp-guide-20260615/"},
      "keywords": keywords.join(', '),
      "inLanguage": "zh-TW"
    })}
