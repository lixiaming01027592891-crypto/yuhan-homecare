      "dateModified": date,
      "url": "https://yuhanhomecare.com/blog/care-center-recommend-selection/",
      "mainEntityOfPage": {
        "@type": "WebPage",
        "@id": "https://yuhanhomecare.com/blog/care-center-recommend-selection/"
      }
    })}
