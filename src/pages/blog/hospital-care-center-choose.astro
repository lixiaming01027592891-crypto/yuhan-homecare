      "@context": "https://schema.org",
      "@type": "Article",
      "headline": title,
      "description": description,
      "author": {"@type": "Organization", "name": "宇涵居家照護站"},
      "publisher": {
        "@type": "Organization",
        "name": "宇涵居家照護站",
