const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: '長輩的錢誰來管？日常花費、代購與財務界線的家庭溝通',
  description: '只要開始有人協助照顧，就一定會碰到代墊與代購。從為什麼要一開始就講清楚、最常出現的代墊情境、留紀錄為何是保護所有人、記帳可以多簡單、收據與發票的保留習慣、預付零用金的做法、看護不涉及金融帳戶操作的角色界線、提款卡與存摺的保管，到家人之間的費用分擔、尊重長輩自己的意願，以及認知功能變化與金錢爭議時的處理原則，分享高雄居家照顧的實務經驗。',
  image: new URL('/images/service-daily.jpg', Astro.site).toString(),
  datePublished: '2026-08-20T08:00:00+08:00',
  author: { '@type': 'Organization', name: '宇涵居家照護' },
