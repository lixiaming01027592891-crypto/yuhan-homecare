            </a>
            <a href="/blog/caregiver-service-scope-boundaries-20260802" class="flex items-start space-x-4 bg-white rounded-xl p-4 border border-[#efe5d5] hover:border-[#8b621f]/30 transition-colors">
              <Image src={serviceCommunication} alt="家屬與看護討論服務範圍與日常協助內容的場景" widths={[80, 160, 240]} sizes="80px" class="w-20 h-20 rounded-lg object-cover flex-shrink-0" loading="lazy" />
