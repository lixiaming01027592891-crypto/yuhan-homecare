const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: '高雄臨時看護怎麼找？醫院陪病與居家照顧的差別與銜接',
  description: '突然住院、家屬請不到假、原本的照顧者自己病倒、出院後的空窗期，都會讓家庭臨時需要人手。從什麼情況會用到高雄臨時看護、醫院陪病與居家照顧在環境與夜間安排上差在哪、臨時需求為什麼比長期難排、家屬第一通電話該先講清楚哪些資訊，到出院回家那幾天的銜接與短期轉長期該重新談的事，分享高雄居家看護的實務經驗。',
  image: new URL('/images/service-temporary.jpg', Astro.site).toString(),
  datePublished: '2026-08-22T08:00:00+08:00',
  author: { '@type': 'Organization', name: '宇涵居家照護' },
  publisher: { '@type': 'Organization', name: '宇涵居家照護', logo: { '@type': 'ImageObject', url: new URL('/images/logo.png', Astro.site).toString() } },
  mainEntityOfPage: { '@type': 'WebPage', '@id': new URL('/blog/kaohsiung-temporary-caregiver-hospital-home-20260822', Astro.site).toString() },
